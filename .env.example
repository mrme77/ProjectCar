# Copy this file to .env when external integrations are introduced.
# Do not place real credentials in this example file.

# RabbitMQ connection (used in the broker phase)
# Change the development-only password before using this outside your Mac.
RABBITMQ_USER=projectcar
RABBITMQ_PASSWORD=projectcar-development-only
RABBITMQ_URL=amqp://projectcar:projectcar-development-only@localhost:5672/%2F
RABBITMQ_EXCHANGE=projectcar.telemetry
RABBITMQ_QUEUE=projectcar.telemetry
RABBITMQ_ROUTING_KEY=telemetry
RABBITMQ_MAX_QUEUE_MESSAGES=10000
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_FAILED_QUEUE=projectcar.telemetry.failed
RABBITMQ_REPLAY_INVALID_QUEUE=projectcar.telemetry.failed.invalid
WORKER_MAX_DELIVERY_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=1.0
WORKER_IDLE_HEARTBEAT_SECONDS=30.0

# Foundry connection (used only by the forwarding worker)
# Keep the real token in Keychain and export it into the worker terminal.
FOUNDRY_TOKEN=
FOUNDRY_HOSTNAME=
FOUNDRY_STREAM_RID=
FOUNDRY_BRANCH=master
FOUNDRY_PREVIEW=true
